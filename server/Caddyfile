# Caddy terminates TLS and enforces Basic auth for every route, including both
# WebSocket endpoints (REQUIREMENTS §5.2). The Node process behind it implements
# no auth of its own, so nothing may reach it that has not passed through here.
#
# Generate the hash with:
#   caddy hash-password
#
# Rotating the password means reflashing every stick, because it is compiled into
# the firmware. That is the accepted alpha trade-off and the reason to move to
# per-device tokens later.

lightstick.example.com {
	basic_auth {
		# One shared account. No accounts means one shared library (§5.1).
		lightstick $2a$14$REPLACE_WITH_THE_OUTPUT_OF_caddy_hash-password
	}

	# reverse_proxy passes Upgrade/Connection through, so /ws/device and
	# /ws/client need no special handling.
	reverse_proxy 127.0.0.1:8080

	encode zstd gzip

	log {
		output stdout
	}
}
